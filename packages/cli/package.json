{
  "name": "ply-ui-cli",
  "version": "1.1.126",
  "description": "Ply CLI — add Angular + Tailwind CSS components to your project (shadcn-style, code is copied in and owned by you). Not MUI Base UI.",
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ply-ui-ng/ply.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ply-ui.com",
  "bugs": {
    "url": "https://github.com/ply-ui-ng/ply/issues",
    "email": "security@ply-ui.com"
  },
  "bin": {
    "ply-ui-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

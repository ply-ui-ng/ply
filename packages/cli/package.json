  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/prompts": "^2.4.9",
    "diff": "^9.0.0",
    "ora": "~5.4.1",
    "prompts": "^2.4.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
